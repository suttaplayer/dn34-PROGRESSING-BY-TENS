@startuml
!pragma hide empty members
title Core Contemplative Qualities and Outcomes
header Generated by Gemini-Model-ID on dd-MMM-YYYY
left to right direction

class "Contemplative" as Contemplative {
    + practice_Dhamma()
    + develop_Skillful_Qualities()
    - abandon_Unskillful_Qualities()
    # reflect_on_Failings()
}

class "Holy_Life" as HolyLife {
    + purpose: Direct_Knowledge
    + purpose: Full_Comprehension
    + outcome: Unbinding
    + outcome: End_of_Suffering_&_Stress
}

class "Virtue" as Virtue {
    + is_consummate()
    + is_pure()
    + has_Shame_&_Compunction()
    + has_Right_Livelihood()
    + has_Sense_Restraint()
    + has_Moderation_in_Eating()
}

class "Mind" as Mind {
    + is_peaceful()
    + is_exquisite()
    + is_luminous()
    + is_pliant()
    + is_malleable()
    - has_Defilements()
}

class "Jhāna" as Jhana {
    + is_heightened_mental_state()
    + is_pleasant_abiding()
}

class "Discernment" as Discernment {
    + knows_Four_Noble_Truths()
    + leads_to_Right_Ending_of_Stress()
    + is_surpassing_state()
}

class "Effluent_Free_Awareness_Release" as AwarenessRelease <<Awareness-Release>> {
    + is_effluent_free()
    + is_discernment_release()
}

class "Unskillful_Qualities" as Unskillful {
    - Possessiveness
    - Ill_will
    - Anger
    - Spitefulness
    - Dismissiveness
    - Antagonism
    - Envy
    - Selfishness
    - Deceit
    - Pretentiousness
    - Evil_Wishes
    - Wrong_View
}

Contemplative --> HolyLife : lives_for
Contemplative o-- Virtue : cultivates
Contemplative o-- Mind : develops
Contemplative o-- Discernment : develops
Contemplative o-- Unskillful : abandons

Virtue <|-- Contemplative : basis_for_practice
Mind <|-- Contemplative : subject_to_cultivation
Discernment <|-- Contemplative : leads_to_insight

Mind --o Jhana : attains_through_concentration
Mind --o AwarenessRelease : achieves_release_through

Unskillful <--o Mind : defiles
Unskillful --> Contemplative : hinder_true_practice
AwarenessRelease <.. Discernment : leads_to_through

@enduml


